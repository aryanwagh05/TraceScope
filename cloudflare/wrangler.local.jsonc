{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tracescope-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tracescope",
      "database_id": "cbacc83c-0ef2-4842-b02c-2d659b33241e",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "TRACE_QUEUE", "queue": "tracescope-traces" }],
    "consumers": [{ "queue": "tracescope-traces", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 }]
  }
}
